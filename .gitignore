# ==========================================
# Neovim Configuration .gitignore
# ==========================================

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini

# Vim / Neovim swap, backup, undo, and session files
*.swp
*.swo
*.swn
*.bak
*~
*.orig
*.rej
*.un~
Session.vim
.netrwhist

# Logs and debug files
*.log
debug
debug.txt

# Temporary / Scratch test files
tt.*
foo.*
test.*
.tests/
.repro/
data/

# Tags
tags
tags.*
doc/tags

# Local overrides, machine-specific configs, or secrets
.env
.env.*
*.local.lua
lua/**/local.lua
lua/**/private.lua

# Ensure lockfile and essential configs are always tracked
!lazy-lock.json
!lazyvim.json
!stylua.toml
